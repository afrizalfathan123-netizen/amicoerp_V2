# Salin jadi .env lalu isi seperlunya. File .env tidak di-commit.

# Di laptop, npm start / tes SELALU memakai database tertanam data/pg, walaupun ini diisi.
# Dipakai hanya di Railway / NODE_ENV=production, perintah dengan --online, dan npm run pindah:postgres.
DATABASE_URL=
# SSL ke database online otomatis (localhost tanpa SSL). Isi "disable" untuk mematikan paksa.
DATABASE_SSL=

PORT=3200
SESSION_DAYS=7

# Untuk npm run import:amico: connection string database ERP AMICO lama (Supabase).
# Project Settings > Database > Connection string. Database lama hanya dibaca.
AMICO_DB_URL=
